REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=ash

# Opcional: si queda vacío, Voice llama al primer AUTHORIZED_OPERATOR_PHONES.
HUMAN_ESCALATION_PHONE=
AUTHORIZED_OPERATOR_PHONES=+5215555550101
