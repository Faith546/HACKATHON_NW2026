PORT=3000
HOST=127.0.0.1
VOICE_RUNTIME_MODE=local
SQLITE_PATH=sqlite.db
PUBLIC_BASE_URL=https://your-public-host.example
PUBLIC_WSS_URL=wss://your-public-host.example

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

OPENAI_API_KEY=
# Credenciales exclusivas del chat de frontend de Raily.
CHAT_FRONTEND_API_KEY=
# Modelo para el chat de frontend de Raily (opcional; por defecto: gpt-4.1-mini).
